{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Envelope schema for all settlement.batch.* outbox events",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "aggregate_type", "aggregate_id", "aggregate_version", "mode", "occurred_at", "payload"],
  "properties": {
    "event_id":          { "type": "string", "minLength": 1 },
    "event_type":        { "type": "string", "pattern": "^settlement\\." },
    "event_version":     { "type": "integer", "minimum": 1 },
    "aggregate_type":    { "type": "string", "minLength": 1 },
    "aggregate_id":      { "type": "string", "minLength": 1 },
    "aggregate_version": { "type": "integer", "minimum": 0 },
    "merchant_id":       { "type": ["string", "null"] },
    "mode":              { "type": "string", "enum": ["simulation", "sandbox", "live"] },
    "correlation_id":    { "type": ["string", "null"] },
    "occurred_at":       { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["public_id", "merchant_code", "currency"],
      "properties": {
        "public_id":      { "type": "string", "minLength": 1 },
        "merchant_code":  { "type": "string", "minLength": 1 },
        "currency":       { "type": "string", "minLength": 3, "maxLength": 3 },
        "gross_amount":   { "type": ["integer", "null"], "minimum": 0 },
        "fee_amount":     { "type": ["integer", "null"], "minimum": 0 },
        "net_amount":     { "type": ["integer", "null"], "minimum": 0 },
        "payment_count":  { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "additionalProperties": false
}

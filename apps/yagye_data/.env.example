# ── S3 / Floci ───────────────────────────────────────────────────────────────
# Leave S3_ENDPOINT_URL empty for real AWS; set it for Floci (local emulator)
S3_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_REGION=us-east-1

BRONZE_BUCKET=yagye-lake-raw
SILVER_BUCKET=yagye-lake-silver
GOLD_BUCKET=yagye-lake-gold
ML_MODELS_BUCKET=yagye-ml-models

# ── PostgreSQL (for pre-P14 outbox polling) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yagye_core_dev

# ── Anthropic (LLM enrichment) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ETL tuning ────────────────────────────────────────────────────────────────
SILVER_ETL_LOOKBACK_HOURS=2
GOLD_ETL_LOOKBACK_HOURS=25

# ── Logging ───────────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development

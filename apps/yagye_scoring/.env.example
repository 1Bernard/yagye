# Copy to .env and fill in values for local development

APP_ENV=development

# S3 / Floci (local AWS emulator)
S3_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_REGION=us-east-1
ML_MODELS_BUCKET=yagye-ml-models

# Redis (feature store — populated by Gold ETL)
REDIS_URL=redis://localhost:6379/0

# Scoring thresholds
ROUTING_SCORE_THRESHOLD=0.60
RISK_BLOCK_THRESHOLD=0.70
RISK_REVIEW_THRESHOLD=0.30

# ML rollout (0 = shadow mode only; 100 = fully active)
ROUTING_ML_ROLLOUT_PERCENT=0
RISK_ML_ROLLOUT_PERCENT=0

<div id="notif-<%= notification.id %>"
     style="border-bottom:1px solid #f3f4f6;">
  <a href="<%= notification_open_path(notification) %>"
     style="display:flex;gap:10px;padding:12px 16px;text-decoration:none;
            <%= notification.read? ? 'background:#fff;' : 'background:#F5F6FF;' %>
            transition:background 120ms;"
     class="notif-row-link">
    <div style="flex-shrink:0;margin-top:2px;">
      <% dot_color = notification.read? ? '#d1d5db' : '#3D47F5' %>
      <span style="display:block;width:7px;height:7px;border-radius:50%;background:<%= dot_color %>;margin-top:4px;"></span>
    </div>
    <div style="flex:1;min-width:0;">
      <p style="font-size:12.5px;font-weight:600;color:#0f1117;margin:0 0 2px;
                overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
        <%= notification.title %>
      </p>
      <p style="font-size:11.5px;color:#6b7280;margin:0;line-height:1.4;
                overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
        <%= notification.body %>
      </p>
      <p style="font-size:10.5px;color:#9ca3af;margin:4px 0 0;">
        <%= notification.created_at.strftime("%-d %b, %H:%M") %>
      </p>
    </div>
  </a>
</div>

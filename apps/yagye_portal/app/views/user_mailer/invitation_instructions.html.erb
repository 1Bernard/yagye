<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5f7;padding:32px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.08);">

        <%# Header %>
        <tr>
          <td style="background-color:#3D47F5;padding:28px 40px;">
            <span style="font-size:18px;font-weight:700;color:#ffffff;letter-spacing:-0.3px;">Yagye</span>
          </td>
        </tr>

        <%# Body %>
        <tr>
          <td style="padding:40px 40px 32px;">
            <h1 style="margin:0 0 8px;font-size:22px;font-weight:700;color:#0f1117;letter-spacing:-0.4px;">
              You've been invited
            </h1>
            <p style="margin:0 0 24px;font-size:14px;color:#6b7280;line-height:1.6;">
              <strong style="color:#0f1117;"><%= @invited_by %></strong>
              has invited you to join
              <strong style="color:#0f1117;"><%= @merchant %></strong>
              on Yagye as a team member.
            </p>

            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:28px;background:#f8f9fa;border-radius:8px;border:1px solid #e5e7eb;">
              <tr>
                <td style="padding:16px 20px;">
                  <p style="margin:0 0 4px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#9ca3af;">Invited email</p>
                  <p style="margin:0;font-size:14px;color:#0f1117;"><%= @user.email %></p>
                </td>
              </tr>
              <tr>
                <td style="padding:0 20px 16px;">
                  <p style="margin:0 0 4px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#9ca3af;">Expires</p>
                  <p style="margin:0;font-size:14px;color:#0f1117;"><%= @expires_at.strftime("%d %B %Y at %H:%M UTC") %></p>
                </td>
              </tr>
            </table>

            <table cellpadding="0" cellspacing="0">
              <tr>
                <td style="border-radius:10px;background-color:#3D47F5;">
                  <a href="<%= @accept_url %>"
                     style="display:inline-block;padding:14px 28px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;letter-spacing:-0.1px;">
                    Accept invitation
                  </a>
                </td>
              </tr>
            </table>

            <p style="margin:24px 0 0;font-size:12px;color:#9ca3af;line-height:1.6;">
              Or copy this link into your browser:<br>
              <span style="color:#6b7280;word-break:break-all;"><%= @accept_url %></span>
            </p>
          </td>
        </tr>

        <%# Footer %>
        <tr>
          <td style="padding:20px 40px;border-top:1px solid #f3f4f6;">
            <p style="margin:0;font-size:11.5px;color:#9ca3af;line-height:1.6;">
              If you didn't expect this invitation, you can safely ignore this email.
              This link expires in 7 days.
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

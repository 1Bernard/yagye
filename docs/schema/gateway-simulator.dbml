// ═══════════════════════════════════════════════════════════════════════════
//  GATEWAY SIMULATOR — Phoenix  ·  database: gateway_simulator
//
//  A SEPARATE DATABASE IS NON-NEGOTIABLE.
//  If the simulator shares Yagye's database it cannot simulate a
//  distributed system, and every lesson in Act II is compromised.
//
//  Its vocabulary is DELIBERATELY not Yagye's — charge_ref not payment_id,
//  PENDING_AUTH not requires_action. If any of these words appear inside
//  Yagye.Payments, the anti-corruption layer has failed and CI says so.
//
//  The simulator is a MODEL OF THE CONTRACT, not a convenient fake. It must
//  be HARDER than any real provider (§XVIII.2).
// ═══════════════════════════════════════════════════════════════════════════

Project gateway_simulator {
  database_type: 'PostgreSQL'
  Note: '''
  Pretends to be Yagye native_rail providers (MTN, Telecel, AirtelTigo, local card acquirers).
  Permanent — it stays in CI forever, because no real provider will send you a duplicate webhook
  40 seconds late on demand.

  Scope boundary
  - native_rail providers only. The simulator is NOT a generic PSP mock.
  - external_psp providers (Stripe, Flutterwave, Paystack) used in Model B orchestration have their
    own vendor sandbox environments (Stripe test mode, Flutterwave test mode, etc.). The yagye_core
    external_psp adapters call those vendor sandboxes directly. This simulator is not involved.
  - Adding external_psp simulation here would duplicate what those vendors already provide and couple
    the simulator to third-party API shapes it does not own.

  Anti-corruption contract
  - Vocabulary is deliberately NOT Yagye core vocabulary: charge_ref not payment_id, PENDING_AUTH
    not requires_action, WALLET not mobile_money. If any of these simulator words appear inside
    YagyeCore.Payments the anti-corruption layer has failed and CI must say so.
  '''
}

Table gw_accounts [headercolor: #6B7A8D] {
  id uuid [pk]
  account_ref text [unique, not null, note: 'acct_… — what WE call the Yagye platform']
  display_name text [not null]
  webhook_url text [not null]
  webhook_secret text [not null, note: 'plaintext ON PURPOSE — this is the simulator pretending to be a provider, and it must be readable to sign test payloads. Never a pattern to copy.']
  webhook_signing_algorithm text [not null, note: 'HS256|HS512|SHA256 — real providers differ; merchant integrations must not hardcode the algorithm']
  settlement_cadence text [not null, note: 'daily|t_plus_2|weekly']
  settlement_cutoff_time time [not null]
  settlement_timezone text [not null, note: 'THEIR timezone. The batch-boundary bug lives here.']
  currency char(3) [not null]
  fee_percentage_bps integer [not null]
  fee_fixed_minor bigint [not null]
  default_scenario_id uuid [note: 'fallback scenario for charges that do not supply one; NULL uses built-in defaults']
  created_at timestamp [not null]
}

// api_key_hash moved to gw_api_keys so teams can rotate keys without downtime.
Table gw_api_keys [headercolor: #6B7A8D] {
  id uuid [pk]
  account_id uuid [not null]
  key_hash text [not null, note: 'SHA-256 of the raw key — simulator only stores the hash']
  label text [not null, note: 'e.g. "ci-pipeline", "alice-dev-machine" — identifies which key to revoke']
  active boolean [not null, default: true]
  created_at timestamp [not null]
  revoked_at timestamp [note: 'NULL = active']
  indexes {
    (account_id, key_hash) [unique]
    (key_hash) [note: 'fast auth lookup — the hot path on every API call']
  }
}

Table gw_charges [headercolor: #1A2B4C] {
  id uuid [pk]
  charge_ref text [unique, not null, note: 'gw_… — NOT pay_…']
  account_id uuid [not null]
  idempotency_key text [note: 'what the caller sent. Lookup by this is what makes an indeterminate charge findable.']
  amount_minor bigint [not null]
  currency char(3) [not null]
  instrument_type text [not null, note: 'CARD|WALLET|BANK — deliberately not card|mobile_money|bank_transfer']
  state text [not null, default: 'PENDING_AUTH', note: 'PENDING_AUTH|AUTHORISED|CAPTURED|PARTIALLY_CAPTURED|VOIDED|DECLINED|REVERSED|AUTH_EXPIRED — deliberately not our vocabulary']
  authorised_amount_minor bigint [note: 'may exceed captured — partial capture is normal for physical goods']
  captured_amount_minor bigint [not null, default: 0, note: 'sum of gw_captures']
  auth_expires_at timestamp [note: 'THE ONE MOST SIMULATORS OMIT. Uncaptured auths expire and the issuer releases the hold. A capture after this MUST fail.']
  authorised_at timestamp
  voided_at timestamp [note: 'a VOID is not a reversal — no money moved, and usually no fee']
  decline_code text
  auth_code text
  rrn text
  arn text
  // Bank transfer / virtual account fields — stored here, NOT in a separate table.
  // A BANK instrument populates these; CARD and WALLET leave them NULL.
  virtual_account_number text [note: 'populated for BANK charges — the account the customer must transfer to']
  virtual_account_bank text [note: 'display name of the simulated receiving bank']
  virtual_account_name text [note: 'account name shown on the bank transfer prompt']
  virtual_account_expires_at timestamp [note: 'single-use virtual accounts expire; a transfer arriving after this is EXPIRED']
  payment_reference text [note: 'the reference the customer must include with the transfer — omission triggers reconciliation failure scenario']
  scenario_id uuid [note: 'which injected scenario produced this outcome — makes a failing test reproducible']
  seed integer [note: 'deterministic replay: same seed, same sequence']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (account_id, idempotency_key) [unique, note: 'partial — WHERE idempotency_key IS NOT NULL']
    (virtual_account_number) [note: 'partial — WHERE virtual_account_number IS NOT NULL; for inbound transfer matching']
  }
}

Table gw_charge_events [headercolor: #B4531F] {
  id uuid [pk]
  charge_id uuid [not null]
  sequence integer [not null]
  event_type text [not null]
  from_state text
  to_state text
  payload jsonb [not null, default: '{}']
  created_at timestamp [not null]
  indexes { (charge_id, sequence) [unique] }
}

Table gw_card_data [headercolor: #6B7A8D] {
  charge_id uuid [pk]
  scenario_pan text [not null, note: 'SCENARIO numbers only — 4000 0000 0000 0006 means TIMEOUT. Never a realistic PAN; CI greps for PAN-shaped strings.']
  brand text
  last4 char(4)
  bin char(8)
  exp_month smallint
  exp_year smallint
  token text [not null, note: 'tok_sim_…']
  avs_result text
  cvv_result text
}

Table gw_three_ds_sessions [headercolor: #B4531F] {
  id uuid [pk]
  charge_id uuid [not null]
  acs_ref text [unique, not null]
  required boolean [not null]
  flow text [not null, note: 'FRICTIONLESS|CHALLENGE']
  outcome text [note: 'APPROVED|DECLINED|ABANDONED|TIMEOUT — all four are testable on demand']
  eci char(2)
  cavv text
  liability_shift boolean
  redirect_delay_ms integer [note: 'lets you force the browser-return-vs-webhook race in either order']
  challenge_started_at timestamp
  completed_at timestamp
}

Table gw_wallet_prompts [headercolor: #1F6B4A] {
  id uuid [pk]
  charge_id uuid [not null]
  network text [not null, note: 'MTN|TELECEL|AIRTELTIGO']
  msisdn text [not null, note: 'FAKE NUMBERS ONLY — 024000000x scenario range. Not PII, and CI greps for anything outside the range.']
  prompt_state text [not null, default: 'SENT', note: 'SENT|APPROVED|DECLINED|EXPIRED']
  approval_delay_ms integer [not null, default: 3000, note: 'the "human presses a button" delay — 5s, 90s, or past the timeout']
  account_name text [note: 'account name as returned by name enquiry — populated from gw_name_enquiries']
  decline_code varchar(255) [note: 'populated when prompt_state = DECLINED — e.g. INSUFFICIENT_FUNDS, USER_REJECTED']
  sent_at timestamp
  resolved_at timestamp
}

// Note: bank transfer virtual account fields (virtual_account_number, virtual_account_bank,
// virtual_account_name, virtual_account_expires_at, payment_reference) live directly on
// gw_charges, not in a separate table. A BANK instrument populates them; CARD/WALLET leave them NULL.

// Name enquiry — required by MTN/Telecel/AirtelTigo before initiating a wallet payment.
// Tests that the caller handles NOT_FOUND, TIMEOUT, and name-mismatch scenarios.
Table gw_name_enquiries [headercolor: #1F6B4A] {
  id uuid [pk]
  charge_id uuid [note: 'NULL if enquiry is a standalone check before charge creation']
  account_id uuid [not null]
  network text [not null, note: 'MTN|TELECEL|AIRTELTIGO']
  msisdn text [not null, note: 'FAKE NUMBERS ONLY — 024000000x range']
  outcome text [not null, note: 'FOUND|NOT_FOUND|TIMEOUT|NETWORK_ERROR']
  account_name text [note: 'NULL when outcome is not FOUND']
  delay_ms integer [not null, default: 200, note: 'simulates network round-trip; set high to trigger caller timeout handling']
  queried_at timestamp [not null]
  indexes { (account_id, msisdn) }
}

Table gw_captures [headercolor: #1F6B4A] {
  id uuid [pk]
  capture_ref text [unique, not null]
  charge_id uuid [not null]
  sequence integer [not null, note: 'multiple captures against one authorisation']
  amount_minor bigint [not null]
  is_final boolean [not null, note: 'a final capture releases the remaining authorised balance']
  outcome text [not null, note: 'OK|EXCEEDS_AUTH|AUTH_EXPIRED|ALREADY_FINAL|DECLINED']
  arn text [note: 'ARN is issued HERE, not at authorisation — the omission that breaks refund tracing']
  captured_at timestamp [not null]
  indexes { (charge_id, sequence) [unique] }
  Note: 'Authorise at order, capture at dispatch. The physical-goods pattern, and the reason auth_expires_at exists at all.'
}

Table gw_incremental_auths [headercolor: #2E4A73] {
  id uuid [pk]
  charge_id uuid [not null]
  sequence integer [not null]
  additional_amount_minor bigint [not null]
  outcome text [not null, note: 'OK|DECLINED|NOT_SUPPORTED — capability differences between providers are the point']
  requested_at timestamp [not null]
  indexes { (charge_id, sequence) [unique] }
}

Table gw_reversals [headercolor: #1F6B4A] {
  id uuid [pk]
  reversal_ref text [unique, not null]
  charge_id uuid [not null]
  amount_minor bigint [not null]
  currency char(3) [not null]
  state text [not null, default: 'REQUESTED', note: 'REQUESTED|OK|FAILED']
  created_at timestamp [not null]
  Note: 'Pre-settlement void only — charge is AUTHORISED but not yet settled. No money moved; no fee. Do not confuse with gw_refunds, which apply after settlement.'
}

// Post-settlement refunds — money has already moved, a new credit is initiated.
// Distinct from gw_reversals (which are pre-settlement voids with no fee).
Table gw_refunds [headercolor: #1F6B4A] {
  id uuid [pk]
  refund_ref text [unique, not null, note: 'RF_… — their reference, not ours']
  charge_id uuid [not null]
  account_id uuid [not null]
  amount_minor bigint [not null, note: 'may be less than charge amount — partial refund']
  currency char(3) [not null]
  state text [not null, default: 'REQUESTED', note: 'REQUESTED|OK|PARTIAL|FAILED']
  refund_arn text [note: 'ARN for the refund credit — different from the charge ARN; NULL until settlement confirms']
  fee_minor bigint [not null, default: 0, note: 'some providers charge a refund processing fee — set to 0 to simulate those that do not']
  failure_code text [note: 'ORIGINAL_NOT_FOUND|ALREADY_REFUNDED|AMOUNT_EXCEEDS_ORIGINAL|WINDOW_EXPIRED']
  injected_defect text [note: 'delayed_arn|fee_surprise|partial_only — which failure mode is under test']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table gw_settlement_files [headercolor: #2E4A73] {
  id uuid [pk]
  account_id uuid [not null]
  file_ref text [unique, not null]
  settlement_date date [not null]
  format text [not null, default: 'JSON', note: 'JSON|CSV|FIXED_WIDTH — reality is not always JSON']
  currency char(3) [not null]
  gross_minor bigint [not null]
  fee_minor bigint [not null]
  net_minor bigint [not null]
  line_count integer [not null]
  injected_defect text [note: 'missing_line|duplicate_line|short_amount|fee_drift|malformed_lines|late_line — THE defect being tested']
  generated_at timestamp [not null]
  indexes {
    (account_id, settlement_date) [note: 'list files for a given account and date']
  }
}

Table gw_settlement_lines [headercolor: #2E4A73] {
  id uuid [pk]
  file_id uuid [not null]
  line_number integer [not null]
  charge_ref text
  line_type text [not null, note: 'CHARGE|REVERSAL|FEE|ADJUSTMENT']
  gross_minor bigint
  fee_minor bigint
  net_minor bigint
  value_date date
  malformed boolean [not null, note: 'when true the row is written deliberately broken — 3 bad lines in 5,000 must still reconcile 4,997']
  indexes { (file_id, line_number) [unique] }
}

Table gw_webhook_deliveries [headercolor: #9B3232] {
  id uuid [pk]
  account_id uuid [not null]
  charge_id uuid [note: 'NULL for account-level events (e.g. settlement.ready)']
  event_id text [not null, note: 'OUR event id. Yagye dedupes on it — so we deliberately reuse it.']
  event_type text [not null]
  payload jsonb [not null, default: '{}']
  signature text [not null]
  scheduled_for timestamp [not null, note: 'delay injection lives here']
  delivery_number integer [not null, default: 1, note: 'greater than 1 = a deliberate duplicate']
  out_of_order boolean [not null, default: false]
  dropped boolean [not null, default: false, note: 'a webhook we deliberately never send — proves the resolver works']
  attempted_at timestamp
  response_status integer
  indexes {
    (account_id) [note: 'list deliveries by account']
    (charge_id) [note: 'list deliveries by charge']
    (scheduled_for) [note: 'Oban polling — relay reads pending deliveries ordered by scheduled_for']
  }
  Note: 'Every distributed-systems failure Yagye must survive is produced from this table on demand.'
}

Table gw_chargebacks [headercolor: #9B3232] {
  id uuid [pk]
  chargeback_ref text [unique, not null, note: 'CB_… — their reference, not ours']
  charge_id uuid [not null]
  account_id uuid [not null]
  amount_minor bigint [not null]
  currency char(3) [not null]
  reason_code text [not null, note: 'FRAUD|NOT_RECEIVED|DUPLICATE|NOT_AS_DESCRIBED — the network taxonomy, not ours']
  instrument_type text [not null, note: 'CARD|WALLET|BANK — stage vocabulary differs by instrument']
  stage text [not null, note: 'Card: RETRIEVAL|FIRST_CHARGEBACK|REPRESENTMENT|PRE_ARBITRATION. Wallet (MTN/Telecel/AirtelTigo): RAISED|RESPONDED|ESCALATED — simpler two-party process, no card-network arbitration tier. CARD stages must not be set for WALLET instruments; CI checks this.']
  state text [not null, default: 'RAISED', note: 'RAISED|RESPONDED|WON|LOST']
  evidence_due_at timestamp [not null, note: 'the field that makes this dangerous — inject a tight deadline to test the reminder path']
  outcome text [note: 'WON|LOST — NULL until final']
  outcome_at timestamp
  injected_defect text [note: 'missed_deadline|short_deadline|duplicate_notification — which failure mode is under test']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (charge_id) [note: 'list chargebacks for a given charge']
    (chargeback_ref) [unique]
  }
  Note: 'Simulates the chargeback notification the provider sends. Card and wallet instruments use different stage vocabularies — do not conflate them.'
}

Table gw_disbursements [headercolor: #1F6B4A] {
  id uuid [pk]
  disbursement_ref text [unique, not null, note: 'DISB_… — their reference for the payout']
  account_id uuid [not null]
  amount_minor bigint [not null]
  currency char(3) [not null]
  destination_type text [not null, note: 'BANK|WALLET']
  destination_ref text [not null, note: 'fake account/msisdn — scenario numbers only']
  state text [not null, default: 'SUBMITTED', note: 'SUBMITTED|PAID|RETURNED|FAILED']
  failure_code text [note: 'INVALID_ACCOUNT|LIMIT_EXCEEDED|ACCOUNT_CLOSED']
  return_reason text [note: 'a payout can bounce DAYS after PAID — inject this to test the re-credit path']
  paid_at timestamp
  returned_at timestamp [note: 'deliberately settable after paid_at to simulate a delayed return']
  confirmation_delay_ms integer [not null, default: 5000, note: 'the gap between SUBMITTED and PAID — tests the polling path']
  injected_defect text [note: 'delayed_confirmation|return_after_paid|silent_failure — which failure mode is under test']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (account_id) [note: 'list disbursements by account']
    (disbursement_ref) [unique]
  }
  Note: 'Simulates the money-out side. Without this the payout state machine (submitted → paid | returned | failed) cannot be tested against a fake provider.'
}

Table gw_scenarios [headercolor: #B4531F] {
  id uuid [pk]
  name text [unique, not null]
  active boolean [not null, default: true]
  is_default boolean [not null, default: false, note: 'exactly one row true — the fallback when charges/accounts supply no scenario_id. Enforced by partial unique index: WHERE is_default = true.']
  seed integer [note: 'set it and the whole run is reproducible — a failing test you cannot reproduce is a test you will delete']

  // Latency profile
  latency_p50_ms integer [not null, default: 80]
  latency_p95_ms integer [not null, default: 400]
  latency_p99_ms integer [not null, default: 1200]

  // Outcome rates (must sum to ≤ 1.0; remainder is provider_error)
  success_rate "numeric(4,3)" [not null, default: 0.900]
  decline_rate "numeric(4,3)" [not null, default: 0.050]
  provider_error_rate "numeric(4,3)" [not null, default: 0.010]
  timeout_rate "numeric(4,3)" [not null, default: 0.040, note: 'timeout WITH the charge created is the scenario that matters most']
  timeout_creates_charge boolean [not null, default: false]

  // Webhook chaos rates
  duplicate_webhook_rate "numeric(4,3)" [not null, default: 0.000]
  out_of_order_rate "numeric(4,3)" [not null, default: 0.000]
  webhook_drop_rate "numeric(4,3)" [not null, default: 0.000]
  webhook_delay_max_ms integer [not null, default: 0]

  // 3DS
  three_ds_required_rate "numeric(4,3)" [not null, default: 0.000]

  // Auth behaviour
  auth_validity_hours integer [not null, default: 24, note: 'how long an uncaptured authorisation survives. Set it to 1 and watch the capture-at-dispatch flow break.']
  supports_partial_capture boolean [not null, default: false]
  supports_multiple_capture boolean [not null, default: false]
  supports_incremental_auth boolean [not null, default: false]
  supports_void boolean [not null, default: true, note: 'some providers make you refund instead of void — a different ledger entry and usually a fee']
  arn_issued_at text [not null, default: 'authorisation', note: 'authorisation|capture|settlement — WHEN the ARN appears. Real providers differ, and it decides whether you can trace a refund.']

  // Settlement chaos
  settlement_discrepancy_rate "numeric(4,3)" [not null, default: 0.000]
  settlement_missing_line_rate "numeric(4,3)" [not null, default: 0.000]
  fee_drift_bps integer [not null, default: 0, note: 'charge 1.6% while the plan expects 1.5% — the aggregate-pattern break']

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (name) [unique]
    (is_default) [unique, note: 'partial — WHERE is_default = true; enforces exactly-one-default invariant']
  }
  Note: 'The control plane, editable live from a LiveView admin page. This one table is why the chaos suite is demonstrable in a browser.'
}

// ── Account ownership ──────────────────────────────────────────────────────
Ref: gw_api_keys.account_id > gw_accounts.id [delete: cascade]
Ref: gw_charges.account_id > gw_accounts.id [delete: restrict]
Ref: gw_disbursements.account_id > gw_accounts.id [delete: restrict]
Ref: gw_refunds.account_id > gw_accounts.id [delete: restrict]
Ref: gw_chargebacks.account_id > gw_accounts.id [delete: restrict]
Ref: gw_settlement_files.account_id > gw_accounts.id [delete: restrict]
Ref: gw_webhook_deliveries.account_id > gw_accounts.id [delete: restrict]
Ref: gw_name_enquiries.account_id > gw_accounts.id [delete: restrict]

// ── Scenario wiring ────────────────────────────────────────────────────────
Ref: gw_accounts.default_scenario_id > gw_scenarios.id [delete: restrict]
Ref: gw_charges.scenario_id > gw_scenarios.id [delete: restrict]

// ── Charge child tables (all RESTRICT — a charge with children must not be deleted) ──
Ref: gw_charge_events.charge_id > gw_charges.id [delete: restrict]
Ref: gw_card_data.charge_id - gw_charges.id [delete: restrict]
Ref: gw_three_ds_sessions.charge_id > gw_charges.id [delete: restrict]
Ref: gw_wallet_prompts.charge_id > gw_charges.id [delete: restrict]
Ref: gw_captures.charge_id > gw_charges.id [delete: restrict]
Ref: gw_incremental_auths.charge_id > gw_charges.id [delete: restrict]
Ref: gw_reversals.charge_id > gw_charges.id [delete: restrict]
Ref: gw_refunds.charge_id > gw_charges.id [delete: restrict]
Ref: gw_chargebacks.charge_id > gw_charges.id [delete: restrict]
Ref: gw_webhook_deliveries.charge_id > gw_charges.id [delete: restrict]
Ref: gw_name_enquiries.charge_id > gw_charges.id [delete: restrict]

// ── Settlement hierarchy ───────────────────────────────────────────────────
Ref: gw_settlement_lines.file_id > gw_settlement_files.id [delete: restrict]

TableGroup provider_side {
  gw_accounts
  gw_api_keys
  gw_charges
  gw_charge_events
  gw_captures
  gw_incremental_auths
  gw_reversals
  gw_refunds
  gw_chargebacks
  gw_disbursements
}
// gw_bank_transfers was designed as a separate table but the real migration
// merged virtual account fields directly onto gw_charges (instrument_type = BANK).
TableGroup instrument_detail {
  gw_card_data
  gw_three_ds_sessions
  gw_wallet_prompts
  gw_name_enquiries
}
TableGroup settlement_reporting {
  gw_settlement_files
  gw_settlement_lines
}
TableGroup failure_injection {
  gw_webhook_deliveries
  gw_scenarios
}

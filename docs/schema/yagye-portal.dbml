// ═══════════════════════════════════════════════════════════════════════════
//  Yagye PORTAL — Rails 8  ·  database: yagye_portal
//
//  SEPARATE DATABASE. The portal holds NO credential for the core database,
//  and that absence is the control that keeps the ledger single-writer.
//
//  This database contains exactly three kinds of thing:
//    1. HUMAN IDENTITY      — who the people are, and what they may do
//    2. HUMAN WORKFLOW      — annotations, notes, saved views, audit
//    3. READ MODELS         — portal_* tables written ONLY by app/consumers/
//
//  It contains NO money. Every financial mutation is a command to the core.
//
//  Rails convention: created_at / updated_at.  Ecto uses inserted_at.
//  The difference is fine — the two databases share no tables, and nothing
//  downstream reads a row timestamp. See §XXI.3.
//
//  RBAC model: DB-backed roles + permissions + role_permissions grant matrix.
//  No hardcoded role checks in policies — see ADR-0017.
// ═══════════════════════════════════════════════════════════════════════════

Project yagye_portal {
  database_type: 'PostgreSQL'
  Note: 'Rails 8 operator and merchant portal. Phlex components (ADR-0016), DB-backed RBAC (ADR-0017), UI::Theme design tokens (ADR-0018).'
}

// ─── HUMAN IDENTITY ───────────────────────────────────────────────────────

Table users [headercolor: #1A2B4C] {
  id uuid [pk, note: 'gen_random_uuid() — UUID PK to match core identity conventions (ADR-0019)']
  user_code text [unique, note: 'USR-A1B2 — stable public handle; generated on create, sent to core as on_behalf_of']
  email citext [unique, not null, note: '[PII] login lookup key — anonymised on erasure (deleted-<id>@invalid), not crypto-shredded, because audit trail rows must still resolve. Documented in §22.1.']
  encrypted_password text [not null, note: '[SEC] Devise bcrypt']
  first_name text [note: '[PII] anonymised on erasure, not shredded']
  last_name text [note: '[PII] anonymised on erasure, not shredded']
  kind text [not null, note: 'merchant_user | internal_staff — determines which role scope applies; enforced by DB CHECK on user_roles']
  reset_password_token text [unique, note: '[SEC] CSPRNG random, never a ULID (ULID leaks creation time)']
  reset_password_sent_at timestamptz
  remember_created_at timestamptz
  sign_in_count integer [not null, default: 0]
  current_sign_in_at timestamptz
  last_sign_in_at timestamptz
  current_sign_in_ip text
  last_sign_in_ip text
  failed_attempts integer [not null, default: 0, note: 'Devise Lockable']
  unlock_token text [unique]
  locked_at timestamptz
  otp_secret text [note: '[SEC] Devise-two-factor TOTP seed — encrypted at rest via ActiveRecord encryption (not bytea; AR handles the envelope)']
  consumed_timestep integer
  otp_required_for_login boolean [not null, default: false, note: 'internal_staff cannot disable — BR-011; enforced in the settings controller']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'HUMAN credentials only. Machine credentials (API keys) live in yagye_core — see ADR-0011. kind determines which role scope is valid for this user. A merchant_user can never hold an internal role and vice versa — enforced by DB CHECK on user_roles.'
}

Table webauthn_credentials [headercolor: #1A2B4C] {
  id uuid [pk, note: 'gen_random_uuid()']
  user_id uuid [not null, ref: > users.id]
  external_id text [unique, not null]
  public_key text [not null, note: '[SEC] passkey public key — phishing-resistant, bound to origin']
  nickname text
  sign_count bigint [not null, note: 'must increase monotonically; a decrease indicates a cloned authenticator']
  aaguid text
  last_used_at timestamptz
  created_at timestamptz [not null]
}

Table user_sessions [headercolor: #6B7A8D] {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id]
  session_token_digest text [unique, not null, note: '[SEC] hashed — never stored plaintext']
  device_fingerprint text [not null, note: 'a new device triggers an email alert — BR-050']
  ip text
  user_agent_hash text [note: '[PII] hashed, never raw UA string']
  mfa_satisfied_at timestamptz
  expires_at timestamptz [not null, note: 'absolute lifetime: 12h for internal_staff, 30d for merchant_user']
  revoked_at timestamptz
  created_at timestamptz [not null]
  Note: 'Refresh rotation with REUSE DETECTION. Presenting a used token revokes the entire session family — use of a reused token is evidence of theft.'
}

// ─── RBAC (DB-backed — ADR-0017) ──────────────────────────────────────────

Table roles [headercolor: #B4531F] {
  key text [pk, note: 'merchant_owner|merchant_admin|merchant_developer|merchant_finance|merchant_support|merchant_read_only|ops_admin|ops_compliance|ops_finance|ops_risk|ops_engineering|ops_support']
  name text [not null]
  scope text [not null, note: 'merchant | internal — a merchant-scoped role can never be granted to a kind=internal_staff user; enforced by DB CHECK on user_roles']
  description text [not null]
  system_role boolean [not null, default: true, note: 'seeded roles cannot be edited or deleted via the portal UI — only a code+migration change can mutate them']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table permissions [headercolor: #B4531F] {
  key text [pk, note: 'dotted resource.action — e.g. payments.view|payments.refund|disputes.view|disputes.action|merchants.view|merchants.approve|kyb.view|kyb.disposition|payouts.view|payouts.action|developers.view|developers.manage|platform_finance.view|team.view|team.manage']
  resource text [not null, note: 'payments|disputes|merchants|kyb|payouts|developers|platform_finance|team']
  action text [not null, note: 'view|action|manage|disposition|approve — fine-grained verbs']
  description text [not null]
  created_at timestamptz [not null]
  Note: 'Seeded from db/seeds.rb. CI asserts every permission key referenced in a Pundit policy exists in this table.'
}

Table role_permissions [headercolor: #B4531F] {
  role_key text [pk, ref: > roles.key]
  permission_key text [pk, ref: > permissions.key]
  granted_at timestamptz [not null]
  Note: 'THE grant matrix. Seeded from db/seeds.rb, version-controlled, tested. permitted?() is a SQL EXISTS against this join cached per-request in Current.permissions. CI asserts no permission key is referenced in a policy but absent here.'
}

Table user_roles [headercolor: #B4531F] {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id]
  role_key text [not null, ref: > roles.key]
  merchant_code text [note: 'mch_01J… for merchant-scoped roles; NULL for internal roles. CHECK: (scope=merchant AND merchant_code IS NOT NULL) OR (scope=internal AND merchant_code IS NULL)']
  granted_by bigint [ref: > users.id]
  granted_at timestamptz [not null]
  expires_at timestamptz [note: 'time-boxed elevation — NULL means permanent; a scheduler sweeps expired rows nightly']
  revoked_at timestamptz
  indexes {
    (user_id, role_key, merchant_code) [unique, note: 'partial: WHERE revoked_at IS NULL AND (expires_at IS NULL OR expires_at > now())']
  }
  Note: 'The audit trail for every grant, elevation, and revocation. scope mismatch between roles.scope and users.kind is a DB CHECK violation. Active scope: revoked_at IS NULL AND (expires_at IS NULL OR expires_at > now()).'
}

Table merchant_memberships [headercolor: #1F6B4A] {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id]
  merchant_code text [not null, note: 'mch_01J… — reference to yagye_core, not a FK across databases']
  merchant_name text [not null, note: 'denormalised from the Kafka merchants topic for display without a core HTTP call']
  state text [not null, note: 'invited|active|suspended|removed']
  invited_by bigint [ref: > users.id]
  invitation_token_digest text [note: '[SEC] single use; cleared after acceptance']
  invitation_expires_at timestamptz
  accepted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (user_id, merchant_code) [unique, note: 'partial: WHERE state = active — BR-013: one active membership per user']
  }
  Note: 'BR-013: a user belongs to exactly one merchant at a time. The partial unique index on (user_id, merchant_code) WHERE state = active enforces it at the DB level.'
}

// ─── HUMAN WORKFLOW ───────────────────────────────────────────────────────

Table audit_logs [headercolor: #9B3232] {
  id bigserial [pk]
  user_id uuid [ref: > users.id]
  user_code text [not null, note: 'denormalised — the log must survive the user being deleted/anonymised']
  merchant_code text
  action text [not null, note: 'payments.refund_requested | disputes.evidence_submitted | kyb.disposition_approved']
  resource_type text [not null]
  resource_code text
  outcome text [not null, note: 'attempted | succeeded | failed — ALL THREE are logged; a failed attempt is as important as a success']
  reason text
  correlation_id text [not null, note: 'joins this row to the core payment_events and the distributed trace']
  ip text
  user_agent_hash text
  metadata jsonb [not null]
  created_at timestamptz [not null]
  Note: 'WHY and BY WHOM. PaperTrail records WHAT CHANGED. Both are necessary; neither replaces the other.'
}

Table versions [headercolor: #6B7A8D] {
  id bigserial [pk]
  item_type text [not null]
  item_id text [not null, note: 'STRING from day one — retrofitting after uuid models exist is painful']
  event text [not null]
  whodunnit text
  object jsonb
  object_changes jsonb
  created_at timestamptz [not null]
  Note: 'PaperTrail. Portal-owned tables only. NEVER on portal_* read models — those are rebuilt from events, not versioned.'
}

Table break_notes [headercolor: #1F6B4A] {
  id bigserial [pk]
  break_code text [not null, note: 'brk_01J… — the break itself lives in yagye_core']
  user_id bigint [not null, ref: > users.id]
  body text [not null]
  visibility text [not null, note: 'internal | merchant_visible']
  del_status boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'The human investigation workflow lives here; the break and its resolution live in the core. Phoenix is the reconciliation engine; Rails is the investigation interface.'
}

Table saved_filters [headercolor: #6B7A8D] {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id]
  namespace text [not null, note: 'Payments:: | Reconciliation:: | Settlements::']
  name text [not null]
  filters jsonb [not null]
  shared_with_merchant boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table notifications [headercolor: #6B7A8D] {
  id bigserial [pk]
  user_id bigint [not null, ref: > users.id]
  kind text [not null]
  title text [not null]
  body text [not null]
  link_path text
  severity text [not null]
  read_at timestamptz
  created_at timestamptz [not null]
}

Table impersonation_sessions [headercolor: #9B3232] {
  id bigserial [pk]
  staff_user_id bigint [not null, ref: > users.id]
  merchant_code text [not null]
  reason text [not null, note: 'MANDATORY — must reference a support ticket']
  read_only boolean [not null, note: 'ALWAYS true — DB CHECK (read_only = true) prevents any code path from creating a write-enabled impersonation session']
  started_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'time-boxed, typically 60 minutes']
  ended_at timestamptz
  Note: 'Support impersonation. Audited, time-boxed, banner-visible, write-blocked. A DB CHECK ensures no future migration can introduce a write-enabled impersonation path.'
}

// ─── READ MODELS  (written ONLY by app/consumers/ — never by controllers) ─

Table portal_payments [headercolor: #2E4A73] {
  payment_code text [pk, note: 'pay_01J…']
  merchant_code text [not null]
  mode text [not null]
  aggregate_version integer [not null, note: 'THE VERSION FENCE — apply only when incoming_version > stored; prevents out-of-order event application']
  state text [not null, note: 'mirrors core aggregate state: initiated|processing|succeeded|failed|refunded|disputed|voided']
  method text
  provider_code text
  amount bigint [not null]
  currency char(3) [not null]
  net_amount bigint
  platform_fee bigint
  provider_fee bigint
  customer_code text
  customer_email_masked text [note: '[PII] gate-3 controlled: masked unless the viewer holds permissions.key = customer_data.view_email']
  customer_msisdn_masked text
  merchant_reference text
  settlement_code text
  settlement_state text
  risk_decision text
  occurred_at timestamptz [not null]
  last_transition_at timestamptz [not null]
  last_event_id text [not null]
  last_applied_at timestamptz [not null, note: 'shown as UI::Freshness — an operator who cannot tell whether a number is current will not trust any number']
  indexes { (merchant_code, occurred_at) }
  Note: 'NO has_paper_trail. NO soft delete. Rebuilt, not versioned. A model-level guard raises on any write from outside app/consumers/.'
}

Table portal_settlements [headercolor: #2E4A73] {
  settlement_code text [pk]
  merchant_code text [not null]
  provider_code text [not null]
  mode text [not null]
  aggregate_version integer [not null]
  state text [not null, note: 'mirrors core: pending|processing|reconciling|reconciled|disputed|failed']
  currency char(3) [not null]
  period_start timestamptz [not null]
  period_end timestamptz [not null]
  expected_net bigint [not null]
  reported_net bigint
  variance bigint
  value_date date
  item_count integer
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
}

Table portal_breaks [headercolor: #B4531F] {
  break_code text [pk]
  run_code text [not null]
  merchant_code text
  provider_code text
  mode text [not null]
  aggregate_version integer [not null]
  classification text [not null]
  severity text [not null]
  state text [not null, note: 'mirrors core: open|under_investigation|resolved|written_off|escalated']
  difference bigint
  currency char(3)
  assigned_to_user_code text
  evidence jsonb
  detected_at timestamptz [not null]
  sla_due_at timestamptz
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (state, severity, detected_at) }
  Note: 'The queue an ops analyst works all day. Turbo Stream broadcasts on insert so work appears without a refresh.'
}

Table portal_merchant_balances [headercolor: #1F6B4A] {
  merchant_code text [pk]
  currency char(3) [pk]
  mode text [pk]
  available bigint [not null]
  pending bigint [not null]
  reserved bigint [not null]
  in_transit bigint [not null]
  last_event_id text
  last_applied_at timestamptz [not null]
  Note: 'MONEY counter — deduped on event_id before incrementing. Version fencing does NOT make counters idempotent (§XVII.4).'
}

Table portal_daily_metrics [headercolor: #1F6B4A] {
  merchant_code text [pk]
  day date [pk]
  currency char(3) [pk]
  mode text [pk]
  payment_count integer [not null]
  succeeded_count integer [not null]
  failed_count integer [not null]
  gross_volume bigint [not null]
  refund_volume bigint [not null]
  chargeback_count integer [not null]
  Note: 'Volume counters recomputed hourly from source. A wrong count self-corrects; a wrong amount is a misstatement — hence recompute, not increment.'
}

Table portal_merchants [headercolor: #1A2B4C] {
  merchant_code text [pk, note: 'mch_01J…']
  aggregate_version integer [not null]
  status text [not null, note: 'mirrors core: registered|under_review|approved|active|suspended|terminated|rejected']
  onboarding_state text [not null]
  legal_name text [not null]
  trading_name text [not null]
  country char(2) [not null]
  default_currency char(3) [not null]
  risk_rating text
  activity_state text [not null]
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  Note: 'Ops onboarding triage and merchant status dashboard without a core API call per row.'
}

Table portal_merchant_applications [headercolor: #1A2B4C] {
  application_code text [pk, note: 'app_01J… — mirrors core public_id']
  aggregate_version integer [not null, default: 0]
  status text [not null, note: 'submitted|under_review|approved|rejected']
  legal_name text [not null]
  trading_name text
  country char(2) [not null]
  industry text
  employee_range text
  submitted_by_email text [note: '[PII] contact email from the application form']
  reviewed_by text
  approved_by text
  rejected_reason text
  merchant_code text [note: 'mch_01J… — set on approval; join to portal_merchants for full merchant view']
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { status [note: 'ops triage queue — filter by status'] }
  Note: 'Ops triage read model. Written only by Karafka consumers on merchant.application.* events. Approved rows link to portal_merchants via merchant_code.'
}

Table portal_disputes [headercolor: #9B3232] {
  dispute_code text [pk, note: 'dsp_01J…']
  payment_code text [not null]
  merchant_code text [not null]
  mode text [not null]
  aggregate_version integer [not null]
  state text [not null, note: 'mirrors core: received|under_review|evidence_submitted|won|lost|accepted|expired']
  stage text
  amount bigint [not null]
  currency char(3) [not null]
  scheme_reason_code text
  evidence_due_at timestamptz [note: 'THE field — reminders at 72h/24h/4h; missed deadline is automatic loss']
  evidence_submitted_at timestamptz
  outcome text
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (state, evidence_due_at) [note: 'partial: WHERE state NOT IN (won, lost, accepted, expired) — open dispute queue'] }
  Note: 'Evidence-deadline queue. Turbo Stream broadcasts on state change.'
}

Table portal_payouts [headercolor: #1F6B4A] {
  payout_code text [pk, note: 'pot_01J…']
  merchant_code text [not null]
  mode text [not null]
  aggregate_version integer [not null]
  state text [not null, note: 'mirrors core: scheduled|validating|reserving|submitted|paid|returned|failed|cancelled']
  amount bigint [not null]
  currency char(3) [not null]
  destination_type text [not null]
  destination_fingerprint text [not null]
  scheduled_for date [not null]
  failure_code text
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (merchant_code, scheduled_for) }
}

Table portal_refunds [headercolor: #1F6B4A] {
  refund_code text [pk, note: 'rfd_01J…']
  payment_code text [not null]
  merchant_code text [not null]
  mode text [not null]
  aggregate_version integer [not null]
  state text [not null, note: 'mirrors core: requested|processing|succeeded|failed|indeterminate']
  amount bigint [not null]
  currency char(3) [not null]
  reason text
  requested_by text [not null]
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (merchant_code, state) [note: 'partial: WHERE state IN (requested, processing) — in-flight refunds'] }
}

// ─── PLATFORM FINANCE (internal Yagye ops only — never merchant-visible) ──

Table portal_platform_daily_metrics [headercolor: #9B3232] {
  day date [pk]
  currency char(3) [pk]
  mode text [pk]
  transaction_count integer [not null]
  gross_volume bigint [not null]
  platform_revenue bigint [not null, note: 'SUM fee_records WHERE party = platform']
  psp_margin_revenue bigint [not null, note: 'native_rail processing revenue']
  orchestration_revenue bigint [not null, note: 'Model B orchestration fee revenue; zero until Model B is live']
  provider_cost bigint [not null, note: 'SUM fee_records WHERE party = provider — what networks charged us']
  gross_margin bigint [not null, note: 'platform_revenue - provider_cost']
  refund_volume bigint [not null]
  dispute_count integer [not null]
  dispute_value bigint [not null]
  chargeback_reserve_drawn bigint [not null]
  last_applied_at timestamptz [not null]
  Note: 'Internal Yagye finance dashboard only. NOT exposed to merchants. Recomputed hourly from fee_records.'
}

Table portal_platform_fee_invoices [headercolor: #9B3232] {
  invoice_id uuid [pk, note: 'mirrors platform_fee_invoices.id in core']
  merchant_code text [not null]
  mode text [not null]
  period_start date [not null]
  period_end date [not null]
  currency char(3) [not null]
  total_amount bigint [not null]
  collection_method text [not null, note: 'cross_net|monthly_invoice|direct_debit']
  state text [not null, note: 'draft|issued|collecting|collected|overdue|written_off']
  settled_against_settlement_code text [note: 'set when cross_net']
  due_at timestamptz
  collected_at timestamptz
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes {
    (merchant_code, period_start, period_end)
    (state) [note: 'partial: WHERE state IN (issued, collecting, overdue)']
  }
}

Table portal_platform_provider_costs [headercolor: #9B3232] {
  day date [pk]
  provider_code text [pk]
  currency char(3) [pk]
  mode text [pk]
  transaction_count integer [not null]
  gross_volume bigint [not null]
  provider_cost bigint [not null]
  average_fee_bps integer [not null, note: 'effective rate in basis points — drift signals contract violation or unannounced fee schedule change']
  last_applied_at timestamptz [not null]
}

// ─── DEVELOPER CONSOLE ────────────────────────────────────────────────────

Table portal_api_keys [headercolor: #2E4A73] {
  key_id uuid [pk, note: 'mirrors api_keys.id in yagye_core — reference, not FK across databases']
  merchant_code text [not null]
  mode text [not null]
  kind text [not null, note: 'publishable|secret']
  key_prefix text [not null, note: 'first 24 chars shown in UI — never the raw key or its hash']
  scopes "text[]" [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  expires_at timestamptz
  created_by text
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (merchant_code, mode) }
  Note: 'Developer console: API key list without hitting core. Revocation is a command to core — this table is the read model.'
}

Table portal_webhook_endpoints [headercolor: #2E4A73] {
  endpoint_id uuid [pk]
  merchant_code text [not null]
  mode text [not null]
  url text [not null]
  subscribed_events "text[]" [not null]
  active boolean [not null]
  consecutive_failures integer [not null]
  disabled_at timestamptz [note: 'auto-disabled after 50 consecutive failures; shown as a banner in the developer console']
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (merchant_code, mode) }
}

Table portal_webhook_deliveries [headercolor: #6B7A8D] {
  delivery_id uuid [pk]
  endpoint_id uuid [not null]
  merchant_code text [not null]
  event_type text [not null]
  state text [not null, note: 'pending|delivering|delivered|failed|exhausted']
  response_status integer
  attempt integer [not null]
  delivered_at timestamptz
  last_applied_at timestamptz [not null]
  indexes { (endpoint_id, last_applied_at) }
  Note: 'Recent delivery log. Aged out after 30 days — core is the record of truth.'
}

// ─── COMPLIANCE REVIEW ────────────────────────────────────────────────────

Table portal_kyb_documents [headercolor: #B4531F] {
  doc_id uuid [pk, note: 'mirrors kyb_documents.id in yagye_core']
  merchant_code text [not null]
  kind text [not null, note: 'incorporation|id|proof_of_address|bank_confirmation']
  uploaded_by text [not null]
  scanned_at timestamptz [note: 'NULL = not yet virus-scanned; ops cannot view the document until this is set']
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (merchant_code) }
  Note: 'Ops document review queue. Document body is in S3 — this is metadata only. Ops clicks through to a presigned URL issued by core.'
}

Table portal_screening_hits [headercolor: #9B3232] {
  hit_id uuid [pk, note: 'mirrors screening_hits.id in yagye_core']
  merchant_code text [not null]
  subject_type text [not null, note: 'entity|beneficial_owner|director|customer']
  list_type text [not null, note: 'pep|sanctions_ofac|sanctions_eu|sanctions_un|sanctions_uk_hmt|adverse_media']
  matched_name text [not null, note: '[PII]']
  match_score "numeric(4,3)" [not null]
  status text [not null, note: 'open|false_positive|true_match_cleared|true_match_blocked']
  dispositioned_at timestamptz
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (merchant_code, status) [note: 'partial: WHERE status = open — open hits queue'] }
  Note: 'Compliance review queue. A sanctions match is an absolute bar — disposition is a command to core passing the same guard. Turbo Stream broadcasts on new hit.'
}

// ─── ORCHESTRATION CONSOLE (enterprise merchants only) ────────────────────

Table portal_provider_connections [headercolor: #6B7A8D] {
  connection_id uuid [pk, note: 'mirrors merchant_provider_connections.id in core']
  merchant_code text [not null]
  provider_code text [not null]
  provider_display_name text [not null]
  provider_kind text [not null, note: 'native_rail|external_psp']
  mode text [not null]
  status text [not null, note: 'active|paused|disabled']
  health_state text [not null, note: 'updated by core circuit breaker — shown as a live status badge']
  enabled_methods "text[]" [not null]
  last_successful_sync_at timestamptz
  credential_expires_at timestamptz [note: 'warning banner shown within 14 days — a silent expiry is a live outage']
  heartbeat_at timestamptz
  last_event_id text [not null]
  last_applied_at timestamptz [not null]
  indexes { (merchant_code, mode) }
  Note: 'Enterprise orchestration console (entitlements.orchestration_enabled: true only). NOT shown to standard merchants.'
}

// ─── INFRASTRUCTURE ───────────────────────────────────────────────────────

Table processed_events [headercolor: #6B7A8D] {
  event_id text [pk]
  consumer text [pk]
  processed_at timestamptz [not null]
  Note: 'Consumer-side dedupe. Required for COUNTER projections where version fencing does not apply. Swept after 30 days.'
}

// ─── RELATIONSHIPS ────────────────────────────────────────────────────────

Ref: webauthn_credentials.user_id > users.id
Ref: user_sessions.user_id > users.id
Ref: role_permissions.role_key > roles.key
Ref: role_permissions.permission_key > permissions.key
Ref: user_roles.user_id > users.id
Ref: user_roles.role_key > roles.key
Ref: user_roles.granted_by > users.id
Ref: merchant_memberships.user_id > users.id
Ref: merchant_memberships.invited_by > users.id
Ref: audit_logs.user_id > users.id
Ref: break_notes.user_id > users.id
Ref: saved_filters.user_id > users.id
Ref: notifications.user_id > users.id
Ref: impersonation_sessions.staff_user_id > users.id

// ─── TABLE GROUPS ─────────────────────────────────────────────────────────

TableGroup identity {
  users
  webauthn_credentials
  user_sessions
  merchant_memberships
}

TableGroup rbac {
  roles
  permissions
  role_permissions
  user_roles
}

TableGroup workflow_and_audit {
  audit_logs
  versions
  break_notes
  saved_filters
  notifications
  impersonation_sessions
}

TableGroup read_models {
  portal_merchants
  portal_payments
  portal_settlements
  portal_breaks
  portal_disputes
  portal_payouts
  portal_refunds
  portal_merchant_balances
  portal_daily_metrics
  processed_events
}

TableGroup platform_finance {
  portal_platform_daily_metrics
  portal_platform_provider_costs
  portal_platform_fee_invoices
}

TableGroup developer_console {
  portal_api_keys
  portal_webhook_endpoints
  portal_webhook_deliveries
}

TableGroup orchestration_console {
  portal_provider_connections
}

TableGroup merchant_onboarding {
  portal_merchant_applications
}

TableGroup compliance_review {
  portal_kyb_documents
  portal_screening_hits
}

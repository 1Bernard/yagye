// ═══════════════════════════════════════════════════════════════════════════
//  MERCHANT PRODUCT LAYER  —  commerce INTENT, not financial transaction
//
//  Everything here creates an obligation or an offer. None of it moves money.
//  The boundary is the same one that separates checkout_sessions from payments:
//      intent to be paid   →   intent to collect   →   money moved
//      (link / invoice)        (payment)               (attempt → ledger)
// ═══════════════════════════════════════════════════════════════════════════

Table customers [headercolor: #1F6B4A] {
  id uuid [pk]
  public_id text [unique, not null, note: 'cus_01J...']
  merchant_id uuid [not null, note: 'a customer belongs to ONE merchant. There is no global customer.']
  mode yagye_mode [not null]
  subject_ref uuid [note: '[PII] → pii_vault. Email, name, phone live there, never here.']
  email_hash text [note: 'HMAC — dedupe and match without retaining the address']
  msisdn_hash text
  external_reference text [note: 'the merchant s own customer id']
  first_seen_at timestamptz [not null]
  last_seen_at timestamptz [not null]
  lifetime_payment_count integer [not null]
  lifetime_gross_volume bigint [not null, note: 'in lifetime_volume_currency. A lifetime total with no currency is meaningless the moment a customer pays in two.']
  lifetime_volume_currency char(3) [not null]
  dispute_count integer [not null, note: 'the single highest-signal risk feature you own']
  inserted_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (merchant_id, email_hash)
    (merchant_id, external_reference) [unique]
  }
  Note: 'Was a gap. Without it, repeat-customer velocity, customer-level dispute history and invoice addressing are all impossible, and the fraud model loses its best feature family.'
}

Table payment_links [headercolor: #1F6B4A] {
  id uuid [pk]
  public_id text [unique, not null, note: 'plk_01J...']
  merchant_id uuid [not null]
  mode yagye_mode [not null]
  url_slug text [unique, not null]
  kind text [not null, note: 'fixed_amount | customer_specified | invoice']
  amount bigint [note: 'NULL when the payer chooses the amount']
  currency char(3) [not null]
  description text [not null]
  image_url text
  allowed_methods "text[]" [not null]
  collect_email boolean [not null]
  collect_phone boolean [not null]
  collect_name boolean [not null]
  reusable boolean [not null, note: 'a shareable link is reusable; an invoice link is single-use']
  max_uses integer
  use_count integer [not null]
  active boolean [not null]
  expires_at timestamptz
  metadata jsonb [not null]
  inserted_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'An OFFER. Creates a checkout_session when opened. A link is not a payment, and one link may produce many payments.'
}

Table invoices [headercolor: #1F6B4A] {
  id uuid [pk]
  public_id text [unique, not null, note: 'inv_01J...']
  merchant_id uuid [not null]
  mode yagye_mode [not null]
  customer_id uuid [not null]
  number text [not null, note: 'merchant-facing sequence, e.g. INV-00123. Gapless per merchant per year — a legal requirement in many jurisdictions.']
  state text [not null, note: 'draft|open|partially_paid|paid|void|uncollectible|overdue']
  subtotal_amount bigint [not null]
  tax_amount bigint [not null]
  discount_amount bigint [not null]
  total_amount bigint [not null]
  amount_paid bigint [not null]
  amount_due bigint [not null]
  currency char(3) [not null]
  issue_date date [not null]
  due_date date [not null]
  payment_link_id uuid
  notes text
  terms text
  sent_at timestamptz
  paid_at timestamptz
  voided_at timestamptz [note: 'an issued invoice is VOIDED, never deleted — same reasoning as the ledger']
  inserted_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (merchant_id, number) [unique] }
  Note: 'A commercial OBLIGATION. It knows nothing about ledger postings, provider fees or settlement. It creates a payment_link; the payment does the rest.'
}

Table invoice_line_items [headercolor: #2E4A73] {
  id uuid [pk]
  invoice_id uuid [not null]
  position integer [not null]
  description text [not null]
  quantity "numeric(12,4)" [not null]
  unit_amount bigint [not null, note: 'currency is inherited from invoices.currency — child tables do not repeat it']
  tax_rate_bps integer [not null]
  total_amount bigint [not null]
  indexes { (invoice_id, position) [unique] }
  Note: 'INVARIANT: SUM(line items) + tax - discount = invoices.total_amount.'
}

Table invoice_deliveries [headercolor: #6B7A8D] {
  id uuid [pk]
  invoice_id uuid [not null]
  channel text [not null, note: 'email|whatsapp|sms|link_copied']
  destination_hash text [not null, note: '[PII] hashed']
  state text [not null, note: 'queued|sent|delivered|opened|failed']
  provider_reference text
  sent_at timestamptz
  delivered_at timestamptz
  opened_at timestamptz
  failure_reason text
  inserted_at timestamptz [not null]
}

// ═══════════════════════════════════════════════════════════════════════════
//  PAYOUT DESTINATIONS  —  was a gap: payouts referenced a fingerprint with
//  no table behind it. This is the highest-value target in the whole system.
// ═══════════════════════════════════════════════════════════════════════════

Table payout_destinations [headercolor: #9B3232] {
  id uuid [pk]
  public_id text [unique, not null, note: 'pdt_01J...']
  merchant_id uuid [not null]
  mode yagye_mode [not null]
  kind text [not null, note: 'bank|mobile_money']
  currency char(3) [not null]
  account_details_encrypted bytea [not null, note: '[SEC] KMS envelope']
  fingerprint text [not null, note: 'hash of the account details — a CHANGE triggers a 24h payout hold and notifies every owner']
  account_name_verified text [note: 'from a name-enquiry or bank verification']
  verification_state text [not null, note: 'unverified|micro_deposit_sent|verified|failed']
  is_default boolean [not null]
  active boolean [not null]
  hold_until timestamptz [note: 'set on change. Account-takeover cash-out runs through this table.']
  inserted_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (merchant_id, mode, fingerprint) [unique] }
}

// ═══════════════════════════════════════════════════════════════════════════
//  BANK RECONCILIATION  —  the third reconciliation (§8.2) had no source table
// ═══════════════════════════════════════════════════════════════════════════

Table bank_statements [headercolor: #6B7A8D] {
  id uuid [pk]
  account_reference text [not null]
  mode yagye_mode [not null]
  statement_date date [not null]
  source text [not null, note: 'api|open_banking|csv_upload|mt940']
  raw_uri text [not null, note: '[EVD] untouched original']
  checksum text [not null]
  opening_balance bigint [not null]
  closing_balance bigint [not null]
  currency char(3) [not null]
  ingested_at timestamptz [not null]
  indexes { (account_reference, statement_date, checksum) [unique] }
}

Table bank_statement_lines [headercolor: #6B7A8D] {
  id uuid [pk]
  statement_id uuid [not null]
  line_number integer [not null]
  value_date date [not null]
  amount bigint [not null, note: 'signed: credits positive, debits negative']
  currency char(3) [not null]
  narrative text [not null, note: 'the free-text field you will spend your life parsing']
  bank_reference text
  counterparty text
  match_state text [not null]
  indexes { (statement_id, line_number) [unique] }
}

// ═══════════════════════════════════════════════════════════════════════════
//  MOBILE MONEY SUPPORT  —  referenced in Part XIX, was missing from the pack
// ═══════════════════════════════════════════════════════════════════════════

Table momo_name_enquiries [headercolor: #2E4A73] {
  id uuid [pk]
  merchant_id uuid
  network text [not null]
  msisdn_hash text [not null]
  returned_name_subject_ref uuid [note: '[PII] masked in UI, never logged in full']
  queried_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'short cache — this is a mild PII exposure, not a directory']
  indexes { (network, msisdn_hash) [unique] }
}

Table momo_network_config [headercolor: #1F6B4A] {
  network text [pk]
  display_name text [not null]
  msisdn_prefixes "text[]" [not null, note: 'NOT authoritative — number portability means a prefix does not determine the network']
  prompt_timeout_seconds integer [not null]
  callback_reliability text [not null, note: 'primary|advisory. Where ADVISORY, polling is the main path and the callback is an optimisation — the inverse of the card design.']
  poll_interval_seconds integer [not null]
  supports_name_enquiry boolean [not null]
  supports_reversal boolean [not null]
  customer_daily_limit bigint [note: 'declines caused by the CUSTOMER s KYC tier, nothing to do with the merchant']
}

// ═══════════════════════════════════════════════════════════════════════════
//  DATA PROTECTION  —  described in Part XIX, was not in the schema
// ═══════════════════════════════════════════════════════════════════════════

Table data_subject_requests [headercolor: #9B3232] {
  id uuid [pk]
  public_id text [unique, not null, note: 'dsr_01J...']
  subject_ref uuid
  requester_email_hash text [not null]
  controller text [not null, note: 'yagye|merchant — decides whether WE answer or forward. Getting this wrong is the most common compliance error. MIGRATION REQUIRED: add CHECK (controller IN (yagye, merchant)) — free text silently routes to nobody on a typo.']
  merchant_id uuid [note: 'set when the merchant is the controller']
  kind text [not null, note: 'access|rectification|erasure|portability|objection']
  state text [not null, note: 'received|identity_verification|in_progress|fulfilled|refused|forwarded']
  identity_verified_at timestamptz [note: 'a DSAR is a social-engineering vector — disclosing to an impostor is itself a breach']
  refusal_basis text [note: 'e.g. statutory financial retention. Must cite the basis and say when it expires.']
  export_uri text
  key_destroyed_at timestamptz [note: 'crypto-shredding executed']
  due_at timestamptz [not null]
  fulfilled_at timestamptz
  handled_by text
  inserted_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table retention_policies [headercolor: #6B7A8D] {
  data_class text [pk, note: 'PII|FIN|SEC|EVD|OPS, or a table name for an override']
  retention_period interval [not null]
  basis text [not null, note: 'legal_obligation|contract|legitimate_interest|consent']
  statutory_reference text
  deletion_method text [not null, note: 'hard_delete|crypto_shred|anonymise|never']
  last_swept_at timestamptz
  Note: 'The retention policy is DATA, executed by RetentionSweep — not a paragraph in a document nobody runs.'
}

// ═══════════════════════════════════════════════════════════════════════════
//  RELATIONSHIPS FOR THE ADDITIONS
// ═══════════════════════════════════════════════════════════════════════════


Ref: customers.merchant_id > merchants.id
Ref: customers.subject_ref > pii_vault.subject_ref
Ref: payment_links.merchant_id > merchants.id
Ref: invoices.merchant_id > merchants.id
Ref: invoices.customer_id > customers.id
Ref: invoices.payment_link_id > payment_links.id
Ref: invoice_line_items.invoice_id > invoices.id
Ref: invoice_deliveries.invoice_id > invoices.id
Ref: checkout_sessions.payment_link_id > payment_links.id
Ref: payments.customer_id > customers.id
Ref: payout_destinations.merchant_id > merchants.id
Ref: payouts.destination_id > payout_destinations.id
Ref: bank_statement_lines.statement_id > bank_statements.id
Ref: momo_name_enquiries.merchant_id > merchants.id
Ref: data_subject_requests.merchant_id > merchants.id
Ref: data_subject_requests.subject_ref > pii_vault.subject_ref
Ref: payment_card_details.cardholder_name_subject_ref > pii_vault.subject_ref
Ref: payment_mobile_money_details.msisdn_subject_ref > pii_vault.subject_ref
Ref: momo_name_enquiries.returned_name_subject_ref > pii_vault.subject_ref
Ref: checkout_sessions.customer_subject_ref > pii_vault.subject_ref

TableGroup merchant_product {
  customers
  payment_links
  invoices
  invoice_line_items
  invoice_deliveries
}

TableGroup money_out {
  payout_destinations
}

TableGroup bank_reconciliation {
  bank_statements
  bank_statement_lines
}

TableGroup mobile_money_support {
  momo_name_enquiries
  momo_network_config
}


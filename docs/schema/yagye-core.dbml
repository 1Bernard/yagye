Ref: merchant_modes.merchant_id > merchants.id
Ref: merchant_checkout_configs.merchant_id - merchants.id
Ref: api_keys.merchant_id > merchants.id
Ref: idempotency_keys.merchant_id > merchants.id
Ref: api_requests.merchant_id > merchants.id
Ref: api_requests.api_key_id > api_keys.id
Ref: beneficial_owners.merchant_id > merchants.id
Ref: beneficial_owners.subject_ref > pii_vault.subject_ref
Ref: kyb_documents.merchant_id > merchants.id
Ref: screening_hits.merchant_id > merchants.id
Ref: provider_credentials.provider_id > providers.id
Ref: provider_credentials.merchant_id > merchants.id
Ref: merchant_provider_connections.merchant_id > merchants.id
Ref: merchant_provider_connections.provider_id > providers.id
Ref: routing_rules.merchant_id > merchants.id
Ref: routing_rule_conditions.rule_id > routing_rules.id
Ref: routing_rule_actions.rule_id > routing_rules.id
Ref: routing_rule_actions.provider_id > providers.id
Ref: payments.merchant_id > merchants.id
Ref: payments.customer_subject_ref > pii_vault.subject_ref
Ref: payment_attempts.payment_id > payments.id
Ref: payment_attempts.provider_id > providers.id
Ref: payment_captures.payment_id > payments.id
Ref: payment_captures.attempt_id > payment_attempts.id
Ref: payment_events.payment_id > payments.id
Ref: payment_card_details.payment_id - payments.id
Ref: payment_three_ds.payment_id - payments.id
Ref: payment_mobile_money_details.payment_id - payments.id
Ref: payment_bank_transfer_details.payment_id - payments.id
Ref: card_declines.attempt_id - payment_attempts.id
Ref: refunds.payment_id > payments.id
Ref: disputes.payment_id > payments.id
Ref: checkout_sessions.merchant_id > merchants.id
Ref: checkout_sessions.payment_id - payments.id
Ref: checkout_sessions.template_id > checkout_templates.id
Ref: checkout_line_items.session_id > checkout_sessions.id
Ref: checkout_events.session_id > checkout_sessions.id
Ref: checkout_templates.merchant_id > merchants.id
Ref: checkout_template_components.template_id > checkout_templates.id [delete: cascade]
Ref: ledger_postings.entry_id > ledger_entries.id
Ref: ledger_postings.account_id > ledger_accounts.id
Ref: ledger_balances.account_id - ledger_accounts.id
Ref: ledger_entries.reverses_entry_id > ledger_entries.id
Ref: pricing_rules.plan_id > pricing_plans.id
Ref: fee_records.pricing_plan_id > pricing_plans.id
Ref: fee_records.pricing_rule_id > pricing_rules.id
Ref: merchants.pricing_plan_id > pricing_plans.id
Ref: settlements.merchant_id > merchants.id
Ref: settlements.provider_id > providers.id
Ref: settlements.reconciliation_run_id > reconciliation_runs.id
Ref: settlement_items.settlement_id > settlements.id

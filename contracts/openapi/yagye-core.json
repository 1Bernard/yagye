{
  "components": {
    "responses": {},
    "schemas": {
      "ApiKey": {
        "description": "An API key \u2014 the secret field is present only on creation and never again",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "example": "key_019526ab3e7f7b4fa19b8be26eac7d14",
            "type": "string"
          },
          "inserted_at": {
            "format": "date-time",
            "type": "string"
          },
          "key": {
            "description": "Full key \u2014 returned ONCE on creation only, never stored",
            "example": "4eC39HqLyjWDarjtT7zdgkd1Axcj3a4eC39HqLyjWD",
            "type": "string"
          },
          "key_prefix": {
            "description": "First 24 chars \u2014 safe to log and display",
            "example": "4eC39HqLyjWDarjtT7zdgkd1",
            "type": "string"
          },
          "kind": {
            "enum": [
              "publishable",
              "secret"
            ],
            "type": "string"
          },
          "mode": {
            "enum": [
              "simulation",
              "sandbox",
              "live"
            ],
            "type": "string"
          },
          "object": {
            "enum": [
              "api_key"
            ],
            "type": "string"
          },
          "revoked_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "scopes": {
            "example": [
              "merchants:read",
              "api_keys:write"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "object",
          "kind",
          "mode",
          "key_prefix",
          "scopes"
        ],
        "title": "ApiKey",
        "type": "object"
      },
      "CreateMerchantRequest": {
        "example": {
          "country": "GB",
          "default_currency": "GBP",
          "legal_name": "Acme Payments Ltd",
          "trading_name": "Acme Pay"
        },
        "properties": {
          "country": {
            "description": "ISO 3166-1 alpha-2 country code",
            "maxLength": 2,
            "minLength": 2,
            "type": "string"
          },
          "default_currency": {
            "description": "ISO 4217 currency code",
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "legal_name": {
            "description": "Legal registered business name",
            "type": "string"
          },
          "metadata": {
            "description": "Arbitrary key-value pairs",
            "type": "object"
          },
          "trading_name": {
            "description": "Trading or DBA name",
            "type": "string"
          }
        },
        "required": [
          "legal_name",
          "trading_name",
          "country",
          "default_currency"
        ],
        "title": "CreateMerchantRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Standard error envelope \u2014 matches Stripe/OpenAI error shape",
        "example": {
          "error": {
            "code": "validation_failed",
            "message": "Country must be a 2-letter ISO code",
            "param": "country",
            "type": "invalid_request_error"
          }
        },
        "properties": {
          "error": {
            "properties": {
              "code": {
                "example": "validation_failed",
                "type": "string"
              },
              "details": {
                "description": "Field-level validation errors",
                "type": "object"
              },
              "message": {
                "example": "Country must be a 2-letter ISO code",
                "type": "string"
              },
              "param": {
                "description": "Field that caused the error",
                "example": "country",
                "type": "string"
              },
              "type": {
                "example": "invalid_request_error",
                "type": "string"
              }
            },
            "required": [
              "type",
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "IssueApiKeyRequest": {
        "example": {
          "kind": "secret",
          "mode": "simulation",
          "scopes": [
            "merchants:read",
            "merchants:write",
            "api_keys:write"
          ]
        },
        "properties": {
          "expires_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "kind": {
            "enum": [
              "publishable",
              "secret"
            ],
            "type": "string"
          },
          "mode": {
            "enum": [
              "simulation",
              "sandbox",
              "live"
            ],
            "type": "string"
          },
          "scopes": {
            "example": [
              "merchants:read"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "kind",
          "mode",
          "scopes"
        ],
        "title": "IssueApiKeyRequest",
        "type": "object"
      },
      "Merchant": {
        "description": "A merchant account",
        "example": {
          "activity_state": "active",
          "api_version": "2026-01-01",
          "country": "GB",
          "default_currency": "GBP",
          "id": "mch_019526ab3e7f7b4fa19b8be26eac7d14",
          "inserted_at": "2026-08-17T10:00:00.000000Z",
          "legal_name": "Acme Payments Ltd",
          "object": "merchant",
          "onboarding_state": "registered",
          "status": "registered",
          "trading_name": "Acme Pay"
        },
        "properties": {
          "activity_state": {
            "enum": [
              "active",
              "dormant",
              "suspended"
            ],
            "type": "string"
          },
          "api_version": {
            "example": "2026-01-01",
            "type": "string"
          },
          "country": {
            "description": "ISO 3166-1 alpha-2",
            "example": "GB",
            "maxLength": 2,
            "minLength": 2,
            "type": "string"
          },
          "default_currency": {
            "description": "ISO 4217",
            "example": "GBP",
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "id": {
            "description": "Public merchant ID",
            "example": "mch_019526ab3e7f7b4fa19b8be26eac7d14",
            "type": "string"
          },
          "inserted_at": {
            "format": "date-time",
            "type": "string"
          },
          "legal_name": {
            "example": "Acme Payments Ltd",
            "type": "string"
          },
          "object": {
            "enum": [
              "merchant"
            ],
            "type": "string"
          },
          "onboarding_state": {
            "enum": [
              "registered",
              "submitted",
              "under_review",
              "approved",
              "rejected"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "registered",
              "approved",
              "suspended",
              "closed"
            ],
            "type": "string"
          },
          "trading_name": {
            "example": "Acme Pay",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "legal_name",
          "trading_name",
          "country",
          "default_currency",
          "status"
        ],
        "title": "Merchant",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer_auth": {
        "description": "API key \u2014 prefix with Bearer or use X-API-Key header",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
